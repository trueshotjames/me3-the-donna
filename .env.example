# Copy to .env and fill in. Never commit .env.

# --- cloud keys (may also be set as system/user environment variables; a value here does not
#     override one already in the environment, so leave these blank in that case) ---
DEEPGRAM_API_KEY=            # Flux (ASR) and Aura-2 (TTS); console.deepgram.com
LLM_API_KEY=                 # OpenRouter key for the fast model ("me3-fast"); openrouter.ai/keys
HERMES_API_KEY=              # same value as API_SERVER_KEY in Hermes's own .env (hermes/setup.*)

# --- LLM (fast model, OpenAI-compatible; OpenRouter by default, routed to Groq hardware) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct   # fastest start; openai/gpt-oss-20b = better tool use, ~0.4 s slower
LLM_PROVIDER_ORDER=groq      # OpenRouter only: try these hosts first (comma-separated)
LLM_PROVIDER_SORT=           # or: latency | throughput | price (used when ORDER is empty)
LLM_ALLOW_FALLBACKS=1
# Leave empty for llama. gpt-oss needs low/medium/high (it rejects none).
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=300
LLM_HISTORY_MESSAGES=12      # history re-sent per call; free tier is 8K tokens/min, 30 req/min
ASSISTANT_NAME=Donna
USER_NAME=King

# --- audio (index from `python -m assistant.main --list-devices`, or a name fragment like "Jabra") ---
# v5: Pi 4 defaults (Jabra Speak USB speakerphone with echo cancellation). On a laptop: leave the devices empty
# and set AUDIO_OUT_SAMPLE_RATE=16000.
# Pi: use pipewire, not Jabra. A name like Jabra opens the sound card directly and locks everyone else out, so the
# Spotify browser falls back to the headphone jack. Through PipeWire her voice and the music share the Jabra.
AUDIO_INPUT_DEVICE=pipewire
AUDIO_OUTPUT_DEVICE=pipewire
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=48000   # the Jabra plays 48 kHz; 16 kHz output makes ALSA resample (crackles, extra lag)
AUDIO_OUT_BUFFER_MS=100        # speaker buffer; the ~30 ms default underruns on a busy Pi (choppy voice). 0 = default
CUES_ENABLED=1                 # beeps: starting / live / stopped working / back (assistant/cues.py)
CUE_VOLUME=0.3
CUE_DOWN_REPEAT_SECS=60

# --- Silero VAD (high recall; only opens the audio gate to Flux) ---
VAD_CONFIDENCE=0.4
VAD_START_SECS=0.1
VAD_STOP_SECS=0.4
VAD_MIN_VOLUME=0.45
GATE_ENABLED=1  # only send audio to Flux after the voice detector hears something
PREROLL_MS=500  # audio from before the detector fired, sent first when the gate opens
BOT_HANGOVER_SECS=1.5  # gate held open while she speaks and this long after
GATE_NOISE_TAIL_SECS=0.8  # close the gate this long after noise that Flux did not take as a turn
FLUX_KEEPALIVE_SECS=5  # while the gate is closed, keep the Flux connection alive this often
FLUX_KEEPALIVE_MODE=silence  # silence | message | off

# --- turn taking ---
TURN_START_STRATEGY=asr  # asr = Flux StartOfTurn starts turns and interruptions; vad = local Silero
EAGER_END_OF_TURN=1           # answer Flux's EagerEndOfTurn early, discard if the user resumes
FLUX_EOT_THRESHOLD=0.6
FLUX_EAGER_EOT_THRESHOLD=0.4
FLUX_EOT_TIMEOUT_MS=5000
USER_TURN_STOP_TIMEOUT=5.0
ENGAGEMENT_WINDOW_SECS=8

# --- streaming over MCP ---
ASR_PUSH_MS=60                # audio block pushed to the ASR server
TTS_CHUNK_MS=80               # audio block returned by tts_read
DEEPGRAM_AURA_VOICE=aura-2-hera-en   # v10: Hera (smooth, warm, professional) suits Donna; was thalia
TTS_SAMPLE_RATE=16000
TTS_PLAYOUT_BUFFER=1          # adaptive buffer: no delay on a fast link, holds audio back only after stutters
TTS_PLAYOUT_START_MS=0        # starting buffer target
TTS_PLAYOUT_MAX_MS=1500       # largest buffer target
TTS_PLAYOUT_MAX_HOLD_MS=1000  # longest she waits before speaking, however slow the link

# --- local servers ---
TOOLS_MCP_HOST=127.0.0.1
TOOLS_MCP_PORT=8766
TOOLS_MCP_AUTOSTART=1         # assistant starts the tools server if nothing answers
UI_WS_HOST=127.0.0.1
UI_WS_PORT=8765
ASSISTANT_DB=assistant.db     # under data/

# --- the house (mcp_servers/tools/devices/): simulated unless a backend is named ---
LIGHT_BACKEND=sim             # sim | tapo (TAPO_*) | gpio (LIGHT_GPIO_PINS="living room:18,bedroom:23", gpiozero PWMLED per room)
LIGHT_ROOMS=living room,bedroom,kitchen
LIGHT_DEFAULT_ROOM=living room   # "lights on" with no room named; "all the lights" still means every room
THERMOSTAT_UNIT=C             # C | F (the simulated room drifts toward the target at 3 degrees C a minute)
MEDIA_BACKEND=sim             # sim | spotify (SPOTIFY_*) | mpv (MUSIC_DIR=~/Music, pip install python-mpv-jsonipc, apt install mpv)
PHONE_BACKEND=sim             # sim | telegram (your account: TELEGRAM_API_ID, TELEGRAM_API_HASH) | telegram_bot (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_IDS; messages only)
# TELEGRAM_API_ID=             # my.telegram.org > API development tools; then: python -m mcp_servers.tools.devices.telegram_login
# TELEGRAM_API_HASH=
# TELEGRAM_CONTACTS=Mom:Maria Santos,Bro:@username   # optional short names
# TELEGRAM_ALLOWED=Love        # only these contacts can be messaged or called (comma-separated; unset = all)
# TELEGRAM_CALLS=direct       # direct (default on the Pi): real call through this machine's Jabra, py-tgcalls | desktop (default on Windows): presses Call in Telegram Desktop | adb (untested): Android phone over USB
# TELEGRAM_CALL_MIC=           # direct: part of a device name (default: Jabra, else the first); TELEGRAM_CALL_SPEAKER= likewise
# ADB_PATH=adb                 # Windows: full path to platform-tools\adb.exe if not on PATH;  ADB_SERIAL= if several phones
# JABRA_BUTTONS=1              # Jabra red/green buttons end/answer Telegram calls (0 = off; Pi: udev rule from app/install_pi.sh)
PHONE_CONTACTS=Mom,Dad,Alex,Sam,Dr. Reyes,Work
SPOTIFY_CLIENT_ID=            # MEDIA_BACKEND=spotify: developer.spotify.com app (PKCE, no secret); then python -m mcp_servers.tools.devices.spotify_login
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEVICE=               # Connect device to play on when Donna is not the speaker herself (SPOTIFY_WEBPLAYER=0)
SPOTIFY_POLL_SECS=5
TAPO_BULBS=                   # LIGHT_BACKEND=tapo: room:IP, e.g. living room:192.168.1.50
TAPO_USERNAME=                # TP-Link / Tapo app account (local KLAP login)
TAPO_PASSWORD=
TAPO_POLL_SECS=15
WEATHER_DEFAULT_CITY=         # get_weather with no city asks about this one (e.g. Quezon City); Open-Meteo, no key


# --- Hermes Agent (background brain for multi-step / open-world tasks; hermes/README.md) ---
HERMES_ENABLED=1
HERMES_URL=http://127.0.0.1:8642
HERMES_NUDGE_SECS=30         # tell the user it is still working after this long
HERMES_MAX_SECS=300          # give up on a task after this long

# --- long-term memory (assistant/memory.py; data/memory/) ---
MEMORY_ENABLED=1
MEMORY_MODEL=                # model that rewrites the memory note; empty = LLM_MODEL
MEMORY_IDLE_SECS=1800        # a conversation ends after this much silence (history is reset, note updated)
MEMORY_EPISODE_MESSAGES=40   # ... or after this many messages (note updated, history kept)
MEMORY_NOTE_MAX_CHARS=4000   # size of the note pasted into the prompt (about 1000 tokens)

# --- voice emotion (Wav2Small, models/wav2small.onnx from tools/export_wav2small.py) ---
EMOTION_ENABLED=1
EMOTION_AD_LOW=0.35          # arousal/dominance hint below this ...
EMOTION_AD_HIGH=0.65         # ... or above this
EMOTION_V_LOW=0.20           # valence hint below this ...
EMOTION_V_HIGH=0.80          # ... or above this
EMOTION_WINDOW_SECS=3
EMOTION_EVERY_SECS=1
EMOTION_SMOOTHING=0.5

LOG_LEVEL=INFO

# --- v6 switches (assistant/config.py); values below are the ones the v6 A/B passes support for the Pi ---
SMART_TURN=0                   # no local Smart Turn (0.65 s per check on a Pi 4); the fast LLM judges the end of turn
LLM_EOT=1
EOT_CHECK=separate             # never offer <wait/> inside the answer request (it suppressed tool calls); parallel check
EOT_CHECK_MODEL=openai/gpt-oss-120b
LLM_EOT_PARTIAL=1              # no measurable effect in Pi mode; 0 is fine too
LLM_WAIT_HOLD_SECS=0.8
DANGLING_HOLD_SECS=1.5         # "Turn on ... the kitchen light" without Smart Turn
VOICE_GATE=1                   # far-away voices (TV, radio) are passed; learns the user's level from answered turns
VOICE_GATE_DB=10
VOICE_GATE_SEED_DB=-16         # Jabra speakerphone: check the user's level on the Pi (logged as "voice gate: ...")
VOICE_GATE_SPEAKER=0           # voice print off (shadow = log only, 1 = enforce); the level gate still runs
FLOOR_CONTROL=0                # v6 A/B: cost ~240 ms per barge-in and did not stop "Okay" from interrupting; DUCK_BARGE_IN replaces it
MCP_TRANSPORT=inproc           # ASR/TTS MCP servers in the assistant process (saves ~155 MB); stdio still works
SPOKEN_HISTORY=1
V6_FIXES=1

# --- v7 switches (assistant/config.py, mcp_servers/tts/server.py); A/B in Pi CPU mode decides the v8 values ---
DUCK_BARGE_IN=1                # pause her audio at the user's speech onset; interrupt on real words, resume on "okay"
DUCK_CONF=0.6
DUCK_FRAMES=2
DUCK_DECIDE_SECS=0.5
DUCK_NO_TURN_SECS=0.8
DUCK_MAX_SECS=2.5
DUCK_PACE=1                    # output at sound-card pace (needed for fdbench's 2x websocket; a Pi sound card is paced)
EOT_ADAPTIVE=1                 # statement hold, trailing words, cut-off check tuned for long remarks
STATEMENT_HOLD_SECS=0.6
LLM_HEDGE_SECS=0.8             # second request with providers swapped if no first token by then
META_FILTER=1                  # drop "We are done. (no further)Done." narration and the rest of that reply
TTS_PHRASE_CACHE=1             # repeated short sentences from the TTS server's memory

# --- v8 switches (consolidation; defaults in code = v7 behaviour) ---
VAD_HOOK_FILTER=1              # Silero's frame hook wakes the event loop only for voiced frames (CPU)
WEATHER_DIRECT=1               # plain weather questions use the tool's own sentence, no second LLM call
SPEAKING_RATE=1                # "speak slower" / "faster" changes Aura's speed (TTS MCP tool tts_set_speed)
TTS_SPEED=0.95                 # start-up speaking rate (0.7-1.5); v10: 0.95 = unhurried, self-assured
TOOL_SLOW_SECS=1.5             # "One moment." when a tool has not answered after this long (0 = off)
SIDE_TALK_RULE=1               # answer only the part of a turn meant for her
V8_FIXES=1                     # the same music "play" or an already-spoken tool result is not run or said twice

# --- v10 Donna persona ---
DONNA_PERSONA=1                # personality, speaking style and tone-aware register (uses the Wav2Small hint)

# --- v9 music-aware listening (assistant/music.py) and room calibration (python -m assistant.calibrate) ---
MUSIC_DUCK=1                 # lower the music while you talk or she speaks
MUSIC_DUCK_LEVEL=15          # percent
MUSIC_RESTORE_SECS=2.5       # back to your volume after this long idle
MUSIC_GAP_DB=5               # uncalibrated: while music plays a voice must be within this of your level
MUSIC_SPEAKER_MIN=0.70       # while music plays the voice print must match at least this well
CALIBRATION_FILE=calibration.json   # under data/
SPOTIFY_WEBPLAYER=0           # 1 = Donna is a Spotify speaker (official Web Playback SDK in a hidden Chrome/Edge/Chromium window)
# SPOTIFY_WEBPLAYER_BROWSER=   # browser path if not found (Pi: /usr/bin/chromium)
# SPOTIFY_WEBPLAYER_ARGS=      # extra browser flags, e.g. --ozone-platform=x11
SPOTIFY_SPEAKER=0             # go-librespot speaker (Spotify refuses audio keys for newer accounts)
SPOTIFY_DEFAULT_PLAYLIST=      # name of one of your playlists or a playlist link; empty = Liked Songs
MUSIC_SPEAKER_ENFORCE=0      # 1 = while music plays, also require a voice-print match (off: too strict on short commands)
