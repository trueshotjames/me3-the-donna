# Hermes Agent secrets for the ME3 assistant. setup.sh / setup.ps1 copy this to Hermes's own
# home (~/.hermes/.env on the Pi, %LOCALAPPDATA%\hermes\.env on Windows). Never commit the copy.

# OpenRouter key for the capable model Hermes uses ("me3-hermes" key, with a spending limit).
OPENROUTER_API_KEY=

# API server the assistant talks to (assistant/services/hermes_client.py).
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Required even on loopback. Put the same value in the assistant's .env as HERMES_API_KEY.
API_SERVER_KEY=

# No messaging platforms: the API server is the only way in.
